{
  "name": "dsh-session-delete",
  "version": "0.1.0",
  "description": "Permanently delete a session from the DeepSeek Harness web GUI: a row-menu action, a confirmation, and a host route that removes the session's log directory.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "delete",
    "plugin"
  ],
  "license": "MIT",
  "author": "mcf171",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcf171/dsh-session-delete.git"
  },
  "bugs": {
    "url": "https://github.com/mcf171/dsh-session-delete/issues"
  },
  "homepage": "https://github.com/mcf171/dsh-session-delete#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
